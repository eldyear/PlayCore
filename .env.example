# === PlayCore — Game Club Control: конфигурация ===
# Скопируйте этот файл в `.env` и заполните реальными значениями.
# `.env` не коммитится в репозиторий (содержит секреты).

# --- База данных ---
# DB_DRIVER: sqlite (по умолчанию) | postgres
DB_DRIVER=sqlite
# Путь к файлу SQLite (для DB_DRIVER=sqlite)
DB_PATH=./data/readyboard.db
# DSN для PostgreSQL (для DB_DRIVER=postgres), например:
# DATABASE_URL=postgres://user:password@localhost:5432/gameclub?sslmode=disable
# DATABASE_URL=

# --- Начальный администратор (создаётся при первом запуске) ---
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME

# --- Глобальный токен агента (legacy — если у ПК нет персонального токена) ---
# AGENT_TOKEN=

# --- Тариф по умолчанию ---
DEFAULT_PRICE=1.0
MAX_MINUTES=0

# --- Название и валюта ---
CLUB_NAME=PlayCore
CURRENCY=KGS

# --- Касса ---
# Требовать открытую смену перед продажей (1/0)
REQUIRE_SHIFT=1

# --- Telegram-уведомления ---
# Токен бота (@BotFather) и chat_id (id группы/чата)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Порог «низкого остатка» в минутах
NOTIFY_LOW_MINUTES=5

# --- HTTPS (опционально) ---
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem

# --- Порт ---
PORT=8080
