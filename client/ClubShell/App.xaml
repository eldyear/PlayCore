<Application x:Class="Club.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Тема: киберпанк (неоновый циан, тёмный фон) -->
        <SolidColorBrush x:Key="BgDark" Color="#07090E"/>
        <SolidColorBrush x:Key="PanelBg" Color="#0D1117"/>
        <SolidColorBrush x:Key="GlassBg" Color="#990D1117"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1E2A3A"/>
        <SolidColorBrush x:Key="Cyan" Color="#00F2FF"/>
        <SolidColorBrush x:Key="CyanDim" Color="#22D3EE"/>
        <SolidColorBrush x:Key="TextMain" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="TextDim" Color="#6E7681"/>
        <SolidColorBrush x:Key="Blood" Color="#FF4B5C"/>

        <!-- Диагональный блик для плиток (как в Steam) -->
        <LinearGradientBrush x:Key="GlareBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#2EFFFFFF" Offset="0.38"/>
            <GradientStop Color="#00FFFFFF" Offset="0.62"/>
        </LinearGradientBrush>

        <!-- Логотип PlayCore (из playcorelogo.png) -->
        <ImageBrush x:Key="LogoBrush" ImageSource="Assets/playcorelogo.png" Stretch="Uniform"/>

        <!-- Стиль плитки игры (карточка с обложкой) -->
        <Style x:Key="GameTile" TargetType="Button">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="240"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0" ClipToBounds="True" BorderThickness="1" BorderBrush="{StaticResource BorderColor}">
                            <Grid>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="{Binding Icon}" Width="56" Height="56" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextMain}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Border x:Name="nameBar" VerticalAlignment="Bottom" Background="#D90A0E14" Padding="10,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextMain}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Border x:Name="glare" IsHitTestVisible="False" Opacity="0" Background="{StaticResource GlareBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-6"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="glare" Property="Opacity" Value="1"/>
                                <Setter TargetName="nameBar" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль пункта меню (еда/напитки) -->
        <Style x:Key="ProductTile" TargetType="Button">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PriceLabel}" FontSize="14" Foreground="{StaticResource Cyan}" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14202E"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка в неоновом стиле: подсветка рамки + свечение при наведении, текст всегда читаем -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GlassBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                                <Setter TargetName="bd" Property="Background" Value="#33132234"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основная кнопка (заливка цианом): при наведении — лёгкое свечение, текст всегда тёмный и читаемый -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Cyan}"/>
            <Setter Property="Foreground" Value="#001014"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33E6FF"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
