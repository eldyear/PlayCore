<Window x:Class="Club.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayCore"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{StaticResource BgDark}"
        ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded">

    <Grid>
        <!-- Фон (с сервера) -->
        <Image x:Name="BgImage" Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0.35"/>

        <!-- ===== Экран блокировки ===== -->
        <Grid x:Name="LockView" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Margin="50,40,0,0">
                <Rectangle Width="32" Height="32" Fill="{StaticResource LogoBrush}"/>
                <TextBlock Text="PlayCore" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Статус (слева по центру) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="LockTitle" Text="ВРЕМЯ ИСТЕКЛО" FontSize="26" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="LockCode" FontSize="40" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock x:Name="LockHint" Text="Обратитесь к администратору" FontSize="16" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Форма входа клиента (справа) -->
                <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360"
                        Background="{StaticResource GlassBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="28,24">
                    <StackPanel>
                        <TextBlock Text="ВОЙТИ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LockLoginHint" Text="Личный кабинет клиента" FontSize="12" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <TextBlock Text="Логин" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,16,0,4"/>
                        <TextBox x:Name="LockLoginBox" FontSize="16" Padding="10,8"
                                 Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}"/>

                        <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="LockPasswordBox" FontSize="16" Padding="10,8"
                                     Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}"
                                     KeyDown="LockPasswordBox_KeyDown"/>
                        <CheckBox x:Name="LockShowPwd" Content="Показать пароль" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,8,0,0" Click="LockShowPwd_Click"/>

                        <TextBlock x:Name="LockLoginError" FontSize="13" Foreground="{StaticResource Blood}" HorizontalAlignment="Center" Margin="0,10,0,0" MinHeight="18" TextWrapping="Wrap"/>

                        <Button Content="Войти" Click="LockLoginOk_Click" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,4,0,0" FontSize="16"/>
                        <Button Content="Стать клиентом" Click="LockRegister_Click" Style="{StaticResource GlassButton}" Height="34" Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource Cyan}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Лаунчер ===== -->
        <Grid x:Name="LauncherView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Хедер -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="40,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="30" Height="30" Fill="{StaticResource LogoBrush}"/>
                        <TextBlock Text="PlayCore" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ClockText" Grid.Column="1" Text="00:00:00" FontSize="30" FontWeight="Bold"
                               FontFamily="Consolas" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Контент: сетка игр + сайдбар -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Сетка игр -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" Margin="30,20,30,10">
                    <ItemsControl x:Name="GamesList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GameTile}" Tag="{Binding}" Click="GameButton_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Сайдбар (прозрачное стекло) -->
                <Border Grid.Column="1" Width="300" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" Background="{StaticResource GlassBg}" Padding="18">
                    <StackPanel>
                        <Border Background="{StaticResource GlassBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="SidebarTitle" Text="Гость" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock x:Name="SidebarTimerLabel" Text="ОСТАЛОСЬ ВРЕМЕНИ" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="SidebarTimer" Text="00:00" FontSize="30" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource Cyan}"/>
                                <TextBlock x:Name="SidebarBalance" Text="" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="SidebarBonus" Text="" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
                                <Button x:Name="RegisterBtn" Content="Стать клиентом" Click="RegisterBtn_Click" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Height="36"/>
                                <Button x:Name="LogoutBtn" Content="Выйти" Click="LogoutBtn_Click" Style="{StaticResource GlassButton}" Margin="0,14,0,0" Height="34" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Магазин" Click="ShopBtn_Click" Style="{StaticResource GlassButton}" Margin="0,16,0,0" Height="46" FontSize="15"/>
                        <Button Content="Вызвать администратора" Click="CallAdminBtn_Click" Style="{StaticResource GlassButton}" Margin="0,10,0,0" Height="46" FontSize="15" Foreground="{StaticResource Cyan}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Футер -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="40,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterInfo" Grid.Column="0" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource CyanDim}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LangBtn" Content="RU" Click="LangBtn_Click" Style="{StaticResource GlassButton}" Height="30" Padding="12,0" FontSize="12"/>
                        <TextBlock x:Name="NetStatus" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="14,0" ToolTip="Интернет"/>
                        <Button x:Name="VolumeMuteBtn" Content="&#xE74F;" FontFamily="Segoe MDL2 Assets" Click="VolumeMute_Click" Style="{StaticResource GlassButton}" Height="30" Width="36" FontSize="13"/>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="60" VerticalAlignment="Center" Margin="8,0"
                                Foreground="{StaticResource Cyan}" ValueChanged="VolumeSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                        <Button x:Name="NvidiaBtn" Content="NVIDIA" Cursor="Hand" Click="NvidiaBtn_Click" Style="{StaticResource GlassButton}"
                                Height="30" Padding="14,0" FontSize="12" Margin="14,0,0,0" Foreground="{StaticResource CyanDim}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Оверлей загрузки (запуск игры) -->
            <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC07090E">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="5" Foreground="{StaticResource Cyan}" Background="{StaticResource PanelBg}"/>
                    <TextBlock x:Name="LoadingText" Text="Запуск..." FontSize="17" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Ввод пароля (выход в Windows) ===== -->
        <Grid x:Name="PasswordView" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <Rectangle Width="48" Height="48" Fill="{StaticResource LogoBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Пароль администратора" FontSize="18" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <PasswordBox x:Name="PasswordBox" FontSize="18" Margin="0,18,0,0" Padding="10" Height="40"
                             Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}"
                             KeyDown="PasswordBox_KeyDown"/>
                <TextBlock x:Name="PasswordError" FontSize="14" Foreground="#FF4B5C" HorizontalAlignment="Center" Margin="0,10,0,0" MinHeight="20"/>
                <Button Content="Войти" FontSize="18" Height="44" Margin="0,12,0,0" Click="OkButton_Click"
                        Background="{StaticResource Cyan}" Foreground="#000" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- ===== Уведомление о малом остатке ===== -->
        <Border x:Name="Pill" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,16,0" CornerRadius="10" Background="#CC0D1117" BorderBrush="{StaticResource Cyan}" BorderThickness="1" Padding="16,10">
            <TextBlock x:Name="PillText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
        </Border>

        <!-- ===== Кастомный Alt+Tab ===== -->
        <Border x:Name="AltTabOverlay" Visibility="Collapsed" Background="#CC07090E">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="ПЕРЕКЛЮЧЕНИЕ ПРИЛОЖЕНИЙ" FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,0,0,22"/>
                <ItemsControl x:Name="AltTabList" Focusable="False" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Height="150" Margin="8" Background="{StaticResource PanelBg}" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                        <Setter Property="Opacity" Value="0.55"/>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.12"/></Setter.Value>
                                                </Setter>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00F2FF" BlurRadius="26" ShadowDepth="0" Opacity="0.75"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="52" Height="52" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextMain}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Сообщение от админа ===== -->
        <Border x:Name="MessageOverlay" Visibility="Collapsed" Background="#99070A12">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource GlassBg}"
                    BorderBrush="{StaticResource Cyan}" BorderThickness="1" Padding="36,28" MaxWidth="560" CornerRadius="0">
                <Border.Effect>
                    <DropShadowEffect Color="#00F2FF" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📢 СООБЩЕНИЕ АДМИНИСТРАТОРА" FontSize="13" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="MessageText" FontSize="22" Foreground="{StaticResource TextMain}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <Button Content="Понятно" FontSize="16" Height="42" Width="160" Margin="0,24,0,0" HorizontalAlignment="Center"
                            Click="MessageOk_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== Регистрация клиента («стать клиентом») ===== -->
        <Grid x:Name="RegisterView" Visibility="Collapsed">
            <Border Background="#99070A12">
                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="380"
                        Background="{StaticResource GlassBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="30,24">
                    <StackPanel>
                        <TextBlock Text="Стать клиентом" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Создайте аккаунт клуба" FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                        <TextBlock Text="Имя (никнейм)" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,14,0,4"/>
                        <TextBox x:Name="RegNameBox" FontSize="16" Padding="10,8"
                                 Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="Телефон (необязательно)" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,10,0,4"/>
                        <TextBox x:Name="RegPhoneBox" FontSize="16" Padding="10,8"
                                 Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="RegPasswordBox" FontSize="16" Padding="10,8"
                                     Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="Повторите пароль" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,10,0,4"/>
                        <PasswordBox x:Name="RegPasswordBox2" FontSize="16" Padding="10,8"
                                     Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}"
                                     KeyDown="RegPasswordBox2_KeyDown"/>
                        <CheckBox x:Name="RegShowPwd" Content="Показать пароль" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,8,0,0" Click="RegShowPwd_Click"/>

                        <TextBlock x:Name="RegisterError" FontSize="13" Foreground="{StaticResource Blood}" HorizontalAlignment="Center" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap"/>

                        <Button Content="Создать аккаунт" Click="RegisterOk_Click" Style="{StaticResource PrimaryButton}" Margin="0,4,0,0" Height="40" FontSize="16"/>
                        <Button Content="Отмена" Click="RegisterCancel_Click" Style="{StaticResource GlassButton}" Margin="0,8,0,0" Height="34"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ===== Магазин (категории → товары) ===== -->
        <Grid x:Name="MenuView" Visibility="Collapsed">
            <Border Background="#99070A12">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource GlassBg}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="440" MaxHeight="600" Padding="24,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MenuTitle" Grid.Row="0" Text="Магазин" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,14">
                            <ItemsControl x:Name="MenuList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProductTile}" Tag="{Binding}" Click="Product_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MenuBackBtn" Grid.Column="0" Content="← Назад" Click="MenuBack_Click" Height="36" Margin="0,0,4,0" Visibility="Collapsed"
                                    Style="{StaticResource GlassButton}"/>
                            <Button Grid.Column="1" Content="Закрыть" Click="MenuClose_Click" Height="36" Margin="4,0,0,0"
                                    Style="{StaticResource GlassButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
